JWT_SECRET=replace_this_with_a_long_random_string
CLOUDFLARE_TUNNEL_TOKEN=paste_your_tunnel_token_here

# Comma-separated list of usernames that get admin status on startup.
# Admin status itself lives in the database (users.is_admin); this only seeds it.
# Admins can create roadmaps and manage every account from the admin panel.
ADMIN_USERNAMES=81hp_

# Password for the very first admin account, created automatically when the
# database has no users at all. Change it right after the first login.
BOOTSTRAP_ADMIN_PASSWORD=change-me-now
