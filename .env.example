JWT_SECRET=replace_this_with_a_long_random_string
CLOUDFLARE_TUNNEL_TOKEN=paste_your_tunnel_token_here

# Comma-separated list of usernames allowed to CREATE roadmaps.
# Everyone else can still log in and view roadmaps shared with them.
# Leave empty to let any account create roadmaps.
ADMIN_USERNAMES=81hp_

# Allow self-service account registration. Default false: the sign-up link is
# hidden and POST /api/auth/register is blocked. Set to true to re-open it.
ALLOW_REGISTRATION=false
