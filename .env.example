# At least 32 random characters, e.g. the output of: openssl rand -hex 48
JWT_SECRET=replace_this_with_a_long_random_string
CLOUDFLARE_TUNNEL_TOKEN=paste_your_tunnel_token_here

# Usernames that get admin status, but only while the install has no admin at
# all (first start). After that, admin status is managed in the admin panel.
ADMIN_USERNAMES=81hp_

# Password for the very first admin account, created automatically when the
# database has no users at all. At least 12 characters; the app will not start
# on an empty database without it. Change it right after the first login.
BOOTSTRAP_ADMIN_PASSWORD=
